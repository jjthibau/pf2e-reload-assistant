# Explicit public source allowlist; private fixtures/operations never enter Git.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/README.md
!/LICENSE
!/CHANGELOG.md
!/CONTRIBUTING.md
!/SECURITY.md
!/module.json
!/package.json
!/scripts/
/scripts/*
!/scripts/main.js
!/styles/
/styles/*
!/styles/reload.css
!/docs/
/docs/*
!/docs/architecture.md
!/docs/testing.md
!/tools/
/tools/*
!/tools/build_release.py
!/tools/check_release.py
**/__pycache__/
**/*.pyc
